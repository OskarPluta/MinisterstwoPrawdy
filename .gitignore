# Source documents (large, not redistributed)
*.pdf

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Frontend (bun)
node_modules/
frontend/dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment / secrets (keep the template)
.env
.env.*
!.env.example

# Local databases (legacy SQLite files from before the Postgres switch)
*.db
*.db-wal
*.db-shm

# Per-user editor / agent settings
.claude/settings.local.json

# Data: only the frozen crawl in data/snapshot/ is committed.
# data/crawl/ = live crawler runs.
/data/*
!/data/snapshot/
# Legacy crawler output location (may hold unmasked personal data)
/crawler/data/
