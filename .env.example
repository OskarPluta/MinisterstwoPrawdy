# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Variables already set in the shell take precedence over this file.

# --- PostgreSQL ----------------------------------------------------------------
# Used by docker-compose.yml to create the database container.
POSTGRES_USER=prawdowid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prawdowid
POSTGRES_PORT=5432

# Used by the app (`rag` CLI, scripts/).
DATABASE_URL=postgresql://prawdowid:change-me@localhost:5432/prawdowid

# Tests and eval scripts create and drop their own throwaway schemas, so they never
# touch existing tables. Set this to point tests at a different database
# (defaults to DATABASE_URL).
# TEST_DATABASE_URL=postgresql://prawdowid:change-me@localhost:5432/prawdowid

# --- LLM -----------------------------------------------------------------------
# Provider: pcss (default) | openai | anthropic
# PRAWDOWID_PROVIDER=pcss

# PCSS (llm.hpc.psnc.pl): open models behind an OpenAI-compatible API, billed in PLN.
PCSS_API_KEY=
# PCSS_MODEL=GLM-5.3-Flash             # or Bielik-11B-v3.0-Instruct (33k context, cheaper)
# PCSS_BASE_URL=https://llm.hpc.psnc.pl/v1
# PCSS_REASONING_EFFORT=

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=medium

# ANTHROPIC_API_KEY=
# PRAWDOWID_MODEL=claude-opus-5-5

# Seconds per LLM request (one retry).
# PRAWDOWID_LLM_TIMEOUT=60
# Price per 1M tokens, for cost reporting of models without a built-in price.
# PRAWDOWID_PRICE_IN=
# PRAWDOWID_PRICE_OUT=
# PRAWDOWID_PRICE_CURRENCY=USD

# --- Embeddings ----------------------------------------------------------------
# Set to 1 to use only the locally cached multilingual-e5 model (no download).
# HF_HUB_OFFLINE=1

# --- API (uv run api) -----------------------------------------------------------
# Must match the embedder used by `rag ingest` (hash only for offline demos).
# PRAWDOWID_EMBEDDER=e5
# API_HOST=127.0.0.1
# API_PORT=8000

# --- Admin panel (uv run admin + admin-frontend/) ---------------------------------
# A separate process from the public API, on 127.0.0.1 by default. It refuses to start without both:
# ADMIN_PASSWORD: shared admin password, at least 12 characters.
# ADMIN_SECRET: at least 32 characters, signs the session cookie (changing it logs everyone out).
# The values below are for local development only: replace both before the panel is reachable by
# anyone else, e.g. python -c "import secrets; print(secrets.token_urlsafe(18)); print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=change-me-admin
ADMIN_SECRET=change-me-dev-secret-0123456789abcdef
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8001
# Set to 1 behind HTTPS (marks the session cookie Secure).
# ADMIN_COOKIE_SECURE=0
# Alerts: Discord webhook (Server settings -> Integrations -> Webhooks). Without it alerts are only
# shown in the panel. Messages never contain the users' text.
# ADMIN_ALERT_DISCORD_WEBHOOK=
# ADMIN_ALERT_POLL_S=30
# Alert when this share of checks failed in the last ADMIN_ALERT_WINDOW_MIN minutes (at least
# ADMIN_ALERT_MIN_CHECKS checks).
# ADMIN_ALERT_ERROR_RATE=0.2
# ADMIN_ALERT_WINDOW_MIN=15
# ADMIN_ALERT_MIN_CHECKS=5
# Alert when a crawler source has had no successful fetch for this many hours (0 = off; the frozen
# data/snapshot would always be stale).
# ADMIN_ALERT_STALE_HOURS=0
# Panel address for links in Discord messages, e.g. https://admin.example.pl
# ADMIN_PUBLIC_URL=
# Set to 0 to turn the alert thread off (e.g. a second admin process).
# ADMIN_NOTIFIER=1
# Admin frontend (Bun, admin-frontend/; reads .env from its own directory or the shell, scripts/dev.sh
# exports these from here):
# ADMIN_API_URL=http://127.0.0.1:8001
# ADMIN_FRONTEND_PORT=3001
# ADMIN_FRONTEND_HOST=127.0.0.1

# --- Discord bot (uv run discord-bot) ------------------------------------------
# Token from Discord Developer Portal -> Bot -> Reset Token.
# DISCORD_BOT_TOKEN=
# Optional: guild (server) ID for instant slash command sync during demos.
# DISCORD_GUILD_ID=
# Optional: fixed request timestamp ISO 8601 (demos on data/snapshot/).
# DISCORD_NOW=
# Optional: forward verification to an already running `uv run api` instead of
# loading the embedder a second time (e.g. http://127.0.0.1:8000).
# DISCORD_API_URL=
# Public frontend URL used by the Discord bot for share links (/wynik/<id>).
# PRAWDOWID_PUBLIC_URL=

# --- Live lookup (rag/live.py) --------------------------------------------------
# When the corpus cannot settle a claim, `rag verify` and the API ask Google Fact Check, EUvsDisinfo
# and gov.pl live (with GOOGLE_FACTCHECK_API_KEY / EUVSDISINFO_API_KEY below; a source without its key
# is skipped). User-Agent contact: CRAWLER_CONTACT or settings.contact in backend/crawler/sources.yaml.
# PRAWDOWID_LIVE=0
# Check log retention in days (table `checks`, docs/DANE_I_LICENCJE.md); 0 = no check log at all.
# PRAWDOWID_CHECKS_RETENTION_DAYS=30
# Public contact for publishers asking for removal (shown on /jak-to-dziala via GET /api/health).
# PRAWDOWID_CONTACT_EMAIL=
# Request limits of the API and the Discord bot (rag/ratelimit.py), per process; 0 turns a limit off.
# PRAWDOWID_RATE_PER_MINUTE=5
# PRAWDOWID_RATE_PER_HOUR=30
# PRAWDOWID_DAILY_CHECKS=1000
# Peers whose X-Forwarded-For the API trusts (the local Bun proxy, the Discord bot).
# PRAWDOWID_TRUSTED_PROXIES=127.0.0.1,::1
# Bearer token of the analyst export GET /api/export (CSV/JSON of the masked check log); unset = endpoint off (404).
# At least 16 characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# PRAWDOWID_ADMIN_TOKEN=
# CRAWLER_CONTACT=

# --- Frontend (bun) ------------------------------------------------------------
# Bun reads .env from its working directory (frontend/), not from here: export these
# in the shell or copy them to frontend/.env.
# API_URL=http://127.0.0.1:8000   # Python API that /api/* is proxied to
# FRONTEND_PORT=3000

# --- Material from users (intake: links, YouTube, images, PDF) ------------------
# Contact address in the User-Agent when fetching links users send (falls back to
# CRAWLER_CONTACT). Without it, links are not fetched and the user is told so.
# INTAKE_CONTACT=zespol@example.pl
# YouTube Data API v3 key (title, description, publication date). Without it only the title and
# channel come from the public oEmbed endpoint. Free key, daily quota.
# YOUTUBE_API_KEY=
# Reading text from images: llm (default; vision model of the provider above, outside the EEA;
# falls back to Tesseract if installed) | tesseract (local) | none
# PRAWDOWID_OCR=llm

# --- EUvsDisinfo MCP (https://mcp.euvsd.info/mcp) -------------------------------
# Key from https://euvsdisinfo.eu/ (details: docs/notes/DODATKOWE_ZRODLA_I_API.md). Used by crawler sources
# euvsdisinfo-* (backend/crawler/sources.d/euvsdisinfo.yaml) and by the live lookup; export it like the Google key.
# EUVSDISINFO_API_KEY=

# --- Google Fact Check Tools API (claims:search; Demagog, Konkret24, AFP Sprawdzam…) ---
# Key from Google Cloud Console (API: Fact Check Tools). Used by crawler sources factcheck-* and the live lookup;
# the crawler does not read .env, so export it first: set -a; . ./.env; set +a
# GOOGLE_FACTCHECK_API_KEY=
