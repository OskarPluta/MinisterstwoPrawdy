# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Variables already set in the shell take precedence over this file.

# --- PostgreSQL ----------------------------------------------------------------
# Used by docker-compose.yml to create the database container.
POSTGRES_USER=prawdowid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prawdowid
POSTGRES_PORT=5432

# Used by the app (`rag` CLI, scripts/).
DATABASE_URL=postgresql://prawdowid:change-me@localhost:5432/prawdowid

# Tests and eval scripts create and drop their own throwaway schemas, so they never
# touch existing tables. Set this to point tests at a different database
# (defaults to DATABASE_URL).
# TEST_DATABASE_URL=postgresql://prawdowid:change-me@localhost:5432/prawdowid

# --- LLM -----------------------------------------------------------------------
# Provider: pcss (default) | openai | anthropic
# PRAWDOWID_PROVIDER=pcss

# PCSS (llm.hpc.psnc.pl): open models behind an OpenAI-compatible API, billed in PLN.
PCSS_API_KEY=
# PCSS_MODEL=GLM-5.3-Flash             # or Bielik-11B-v3.0-Instruct (33k context, cheaper)
# PCSS_BASE_URL=https://llm.hpc.psnc.pl/v1
# PCSS_REASONING_EFFORT=

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=medium

# ANTHROPIC_API_KEY=
# PRAWDOWID_MODEL=claude-opus-5-5

# Seconds per LLM request (one retry).
# PRAWDOWID_LLM_TIMEOUT=60
# Price per 1M tokens, for cost reporting of models without a built-in price.
# PRAWDOWID_PRICE_IN=
# PRAWDOWID_PRICE_OUT=
# PRAWDOWID_PRICE_CURRENCY=USD

# --- Embeddings ----------------------------------------------------------------
# Set to 1 to use only the locally cached multilingual-e5 model (no download).
# HF_HUB_OFFLINE=1

# --- API (uv run api) -----------------------------------------------------------
# Must match the embedder used by `rag ingest` (hash only for offline demos).
# PRAWDOWID_EMBEDDER=e5
# API_HOST=127.0.0.1
# API_PORT=8000

# --- Discord bot (uv run discord-bot) ------------------------------------------
# Token from Discord Developer Portal -> Bot -> Reset Token.
# DISCORD_BOT_TOKEN=
# Optional: guild (server) ID for instant slash command sync during demos.
# DISCORD_GUILD_ID=
# Optional: fixed request timestamp ISO 8601 (demos on data/snapshot/).
# DISCORD_NOW=
# Optional: forward verification to an already running `uv run api` instead of
# loading the embedder a second time (e.g. http://127.0.0.1:8000).
# DISCORD_API_URL=

# --- Live lookup (rag/live.py) --------------------------------------------------
# When the corpus cannot settle a claim, `rag verify` and the API ask Google Fact Check, EUvsDisinfo
# and gov.pl live (with GOOGLE_FACTCHECK_API_KEY / EUVSDISINFO_API_KEY below; a source without its key
# is skipped). User-Agent contact: CRAWLER_CONTACT or settings.contact in backend/crawler/sources.yaml.
# PRAWDOWID_LIVE=0
# CRAWLER_CONTACT=

# --- Frontend (bun) ------------------------------------------------------------
# Bun reads .env from its working directory (frontend/), not from here: export these
# in the shell or copy them to frontend/.env.
# API_URL=http://127.0.0.1:8000   # Python API that /api/* is proxied to
# FRONTEND_PORT=3000

# --- EUvsDisinfo MCP (https://mcp.euvsd.info/mcp) -------------------------------
# Key from https://euvsdisinfo.eu/ (details: docs/notes/DODATKOWE_ZRODLA_I_API.md). Used by crawler sources
# euvsdisinfo-* (backend/crawler/sources.d/euvsdisinfo.yaml) and by the live lookup; export it like the Google key.
# EUVSDISINFO_API_KEY=

# --- Google Fact Check Tools API (claims:search; Demagog, Konkret24, AFP Sprawdzam…) ---
# Key from Google Cloud Console (API: Fact Check Tools). Used by crawler sources factcheck-* and the live lookup;
# the crawler does not read .env, so export it first: set -a; . ./.env; set +a
# GOOGLE_FACTCHECK_API_KEY=
